# Paths are resolved from the repository directory unless made absolute.
LABRAG_ROOT=.
LABRAG_DATA_DIR=data
LABRAG_RCLONE=rclone
LABRAG_RCLONE_CONFIG=.config/rclone/rclone.conf
LABRAG_REMOTE=gdrive

# Use a folder ID from your own Google Drive account.
LABRAG_LIVE_DRIVE_ENABLED=true
LABRAG_LIVE_DRIVE_ROOT_ID=your-drive-folder-id
LABRAG_LIVE_DRIVE_TIMEOUT=5

# Model and vector service endpoints.
LABRAG_QDRANT_URL=http://127.0.0.1:6333
LABRAG_EMBED_URL=http://127.0.0.1:8080
LABRAG_RERANK_URL=http://127.0.0.1:8081
LABRAG_VLLM_URL=http://127.0.0.1:8000/v1
LABRAG_VLLM_MODEL=qwen
LABRAG_MODEL_ID=LabRAG

# Optional external sources.
SLACK_TOKEN=your-slack-token
LABRAG_TAVILY_API_KEY=your-tavily-api-key
LABRAG_WEB_SEARCH_ENABLED=false
